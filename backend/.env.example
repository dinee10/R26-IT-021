# Copy the values you need into backend/.env. Never commit backend/.env.

# Required by the herbal knowledge assistant.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Required before using the expert-only verification endpoints.
EXPERT_REVIEW_KEY=replace-with-a-long-random-secret

# Add the final Flutter web origins as a comma-separated list.
# Android applications do not require a CORS origin.
ALLOWED_ORIGINS=https://your-project.web.app,https://www.example.com

# Keep the origin private when cloudflared runs on this computer.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# A small thread count avoids loading duplicate ML models into separate
# processes while still allowing multiple requests to be served.
BACKEND_THREADS=4
BACKEND_CHANNEL_TIMEOUT=240

# Load TensorFlow and YOLO models once when the production server starts.
# Keep this enabled to avoid making the first mobile request pay model-load time.
PRELOAD_ML_MODELS=true

# Only enable this on a host with enough RAM/page-file capacity. The default
# warm-up above covers the quality assessment flow; this also loads live YOLO
# and the separate plant/seed/flower identification models.
PRELOAD_ALL_ML_MODELS=false

# Uploaded quality images are kept only in memory and expire after five minutes.
QUALITY_UPLOAD_TTL_SECONDS=300
QUALITY_MAX_PENDING_UPLOADS=32

# The application accepts image uploads up to 25 MiB by default.
MAX_UPLOAD_BYTES=26214400

# Use an absolute path if verification data should live outside the repository.
# VERIFICATION_DATA_DIR=D:\AyurPlantData\verifications
